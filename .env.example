# All optional. The app runs fully locally (localStorage) with none of these set.

# Supabase auth + cloud storage (leave blank to use localStorage only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paystack - TEST MODE ONLY. Keys not starting with sk_test_ are rejected.
PAYSTACK_SECRET_KEY=

# Paid add-on: WhatsApp Cloud API bulk send (stub, not active)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Paid add-on: SMS bulk send (stub, not active)
SMS_API_KEY=
